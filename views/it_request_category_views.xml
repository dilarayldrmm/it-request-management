<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_it_request_category_list" model="ir.ui.view">
        <field name="name">it.request.category.list</field>
        <field name="model">it.request.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_it_request_category_form" model="ir.ui.view">
        <field name="name">it.request.category.form</field>
        <field name="model">it.request.category</field>
        <field name="arch" type="xml">
            <form string="IT Request Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_request_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">it.request.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_it_request_category"
        name="Categories"
        parent="menu_it_management_root"
        action="action_it_request_category"
        sequence="20"
    />

</odoo>