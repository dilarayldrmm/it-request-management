<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ASSIGNMENT HISTORY LIST VIEW -->
    <record id="view_it_equipment_assignment_list" model="ir.ui.view">
        <field name="name">it.equipment.assignment.list</field>
        <field name="model">it.equipment.assignment</field>

        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">

                <field name="equipment_id"/>

                <field name="user_id"/>

                <field name="assigned_date"/>

                <field name="returned_date"/>

                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'active'"
                    decoration-muted="status == 'returned'"
                />

            </list>
        </field>
    </record>


    <!-- ASSIGNMENT HISTORY FORM VIEW -->
    <record id="view_it_equipment_assignment_form" model="ir.ui.view">
        <field name="name">it.equipment.assignment.form</field>
        <field name="model">it.equipment.assignment</field>

        <field name="arch" type="xml">

            <form
                string="Equipment Assignment"
                create="false"
                edit="false"
                delete="false"
            >

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="equipment_id"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Assignment">

                            <field name="user_id"/>

                            <field name="assigned_date"/>

                            <field name="returned_date"/>

                            <field name="status"/>

                        </group>

                    </group>

                    <group string="Notes">

                        <field name="note"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- SEARCH VIEW -->
    <record id="view_it_equipment_assignment_search" model="ir.ui.view">
        <field name="name">it.equipment.assignment.search</field>
        <field name="model">it.equipment.assignment</field>

        <field name="arch" type="xml">

            <search string="Search Assignment History">

                <field name="equipment_id"/>

                <field name="user_id"/>

                <separator/>

                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('status', '=', 'active')]"
                />

                <filter
                    name="filter_returned"
                    string="Returned"
                    domain="[('status', '=', 'returned')]"
                />

                <group expand="0" string="Group By">

                    <filter
                        name="group_by_equipment"
                        string="Equipment"
                        context="{'group_by': 'equipment_id'}"
                    />

                    <filter
                        name="group_by_user"
                        string="Assigned User"
                        context="{'group_by': 'user_id'}"
                    />

                    <filter
                        name="group_by_status"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />

                </group>

            </search>

        </field>
    </record>


    <!-- ACTION -->
    <record id="action_it_equipment_assignment" model="ir.actions.act_window">

        <field name="name">Assignment History</field>

        <field name="res_model">it.equipment.assignment</field>

        <field name="view_mode">list,form</field>

        <field
            name="search_view_id"
            ref="view_it_equipment_assignment_search"
        />

    </record>

</odoo>